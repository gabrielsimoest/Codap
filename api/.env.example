# URL de conexão com o banco Postgres (NeonDB), usada pelo Prisma via prisma.config.ts
DATABASE_URL=

# Segredo usado para assinar/verificar os access tokens JWT (src/plugins/jwt.ts)
JWT_ACCESS_SECRET=

# E-mails de confirmação, redefinição de senha e boas-vindas (src/plugins/mailer.ts)
# Chave de API do Resend. Sem ela nada é enviado: em desenvolvimento o e-mail vai para o log
# da API (dá para clicar no link dali); em produção vira um erro no log.
RESEND_API_KEY=
# Remetente. O domínio precisa estar verificado no Resend. Padrão: Codap <no-reply@gabrielreverso.dev.br>
MAIL_FROM=
# URL pública da API, base dos links dos e-mails (as páginas de confirmação e de nova senha
# são servidas por ela). Sem barra no final. Obrigatória fora de desenvolvimento;
# em desenvolvimento o padrão é http://localhost:3000.
PUBLIC_URL=
